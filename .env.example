# Copy to .env for local development. Never commit the real .env file.
#
# Used by app/lib/sendRegisterEmail.server.ts to send the register-interest form
# to info@branchleft.co.uk over SMTP AUTH submission (port 587, STARTTLS required).
#
# PUBLICPRESS_SMTP_USER / PUBLICPRESS_SMTP_PASSWORD are a dedicated
# submission-only credential: send-as only, so a leaked value cannot read mail.
#
# In production these are set in /etc/branchleft/publicpress-website.env on the
# host, not loaded from this file.
PUBLICPRESS_SMTP_HOST=
PUBLICPRESS_SMTP_PORT=587
PUBLICPRESS_SMTP_USER=
PUBLICPRESS_SMTP_PASSWORD=

# Test only: when set, a send appends a JSON line to this file instead of
# contacting an SMTP server. The end-to-end suite sets it. Leave it unset
# everywhere else.
# PUBLICPRESS_MAIL_STUB_FILE=test-results/outbox.jsonl
